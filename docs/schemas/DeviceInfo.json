{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clipharbor.local/schemas/v1/DeviceInfo.json",
  "title": "DeviceInfo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviceId",
    "name",
    "platform",
    "appVersion",
    "protocolVersion"
  ],
  "properties": {
    "deviceId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "platform": {
      "enum": [
        "windows",
        "ios",
        "macos"
      ]
    },
    "appVersion": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "string"
    }
  }
}